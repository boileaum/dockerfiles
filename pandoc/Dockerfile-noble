# Utilisation de l'image officielle Ubuntu 24.04 LTS (Noble Numbat)
FROM ubuntu:24.04

# Métadonnées et labels selon les standards OCI
LABEL org.opencontainers.image.title="Pandoc with TeXLive"
LABEL org.opencontainers.image.description="Pandoc document converter with TeXLive support and Paris timezone configuration."
LABEL org.opencontainers.image.authors="Matthieu Boileau <matthieu.boileau@math.unistra.fr>"
LABEL org.opencontainers.image.created="2025-06-06"
LABEL org.opencontainers.image.version="1.0"

# Configuration du fuseau horaire avant l'installation des paquets
ENV TZ=Europe/Paris
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Installation des paquets système en une seule couche optimisée
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        make \
        texlive-xetex \
        texlive-fonts-extra \
        texlive-science \
        texlive-latex-base \
        texlive-fonts-recommended \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-plain-generic \
        lmodern \
        pandoc \
        python3-pip \
        python3-venv && \
    mktexlsr && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Création d'un utilisateur non-root avec UID/GID explicites pour la sécurité
RUN groupadd -g 1001 pandoc && \
    useradd -u 1001 -g pandoc -m -s /bin/bash pandoc

# Configuration de l'environnement utilisateur
ENV HOME=/home/pandoc
ENV PATH=${HOME}/.venv/bin:$PATH

# Changement vers l'utilisateur non-root
USER pandoc
WORKDIR $HOME

# Création d'un environnement virtuel Python et installation des paquets
RUN python3 -m venv ~/.venv && \
    ~/.venv/bin/pip install --no-cache-dir --upgrade pip && \
    ~/.venv/bin/pip install --no-cache-dir pantable

# Ajout d'un healthcheck pour vérifier que pandoc fonctionne
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pandoc --version || exit 1

# Point d'entrée par défaut
CMD ["/bin/bash"]
